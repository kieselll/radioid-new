[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float shadow_angle = 10.0;
uniform float shadow_length = 135.0;
uniform sampler2D screen_tex_frg_13 : hint_screen_texture;



void fragment() {
// FloatParameter:3
	float n_out3p0 = shadow_angle;


// FloatFunc:6
	float n_out6p0 = radians(n_out3p0);


// FloatFunc:7
	float n_out7p0 = cos(n_out6p0);


// FloatFunc:8
	float n_out8p0 = sin(n_out6p0);


// VectorCompose:9
	vec2 n_out9p0 = vec2(n_out7p0, n_out8p0);


// FloatParameter:4
	float n_out4p0 = shadow_length;


// VectorOp:10
	vec2 n_out10p0 = n_out9p0 * vec2(n_out4p0);


// Input:2
	vec2 n_out2p0 = UV;


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 + n_out2p0;


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(screen_tex_frg_13, n_out11p0);


// Output:0
	COLOR.rgb = vec3(n_out13p0.xyz);


}
"
