; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="idkrim"
run/main_scene="res://scenes/menu.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.0901961, 0.0901961, 0.0901961, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://bfygxhwvhxnb6"
config/icon="uid://bfygxhwvhxnb6"

[autoload]

GlobalSaver="*res://scripts/autoloads/Saver.gd"
GlobalLogger="*res://scripts/autoloads/logger.gd"
GlobalRef="*res://scripts/autoloads/ReferenceDB.gd"
GlobalCfg="*res://scripts/autoloads/ConfigDB.gd"
SceneTransition="*res://scenes/autoloads/scene_transition.tscn"
BuildableDB="*res://scripts/autoloads/BuildableDB.gd"
DebugMenu="*res://scenes/autoloads/debug_menu.tscn"
InputHandler="*res://scripts/autoloads/input_handler.gd"
GridUtils="*uid://gbt8dd5ngoow"

[debug]

gdscript/warnings/narrowing_conversion=0

[display]

window/vsync/vsync_mode=2
mouse_cursor/custom_image="res://textures/ui/cursor.png"

[editor]

movie_writer/movie_file="C:/Users/Kirill/Desktop/Movie.avi"

[file_customization]

folder_colors={
"res://resources/": "orange",
"res://scenes/": "blue",
"res://scripts/": "green",
"res://shaders/": "purple",
"res://sounds/": "pink",
"res://textures/": "red"
}

[gui]

theme/custom="res://resources/theme.tres"
theme/custom_font="res://resources/Gilroy-Bold.ttf"

